@model List<ClinicCare.ViewModels.AppointmentListViewModel>

@{
    Layout = "_DashboardLayout";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success auto-alert">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger auto-alert">
        @TempData["Error"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="mb-0">
            <i class="bi bi-calendar-check me-2"></i>
            Appointments
        </h2>

        <small class="text-muted">
            Manage patient appointment requests
        </small>

    </div>

</div>





        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Patient Code</th>

                        <th>Patient Name</th>

                        <th>Date</th>

                        <th>Time Slot</th>

                        <th>Status</th>

                        <th width="250">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <span class="badge bg-primary">

                                        @item.PatientCode

                                    </span>

                                </td>

                                <td class="fw-semibold">

                                    @item.PatientName

                                </td>

                                <td>

                                    @item.AppointmentDate.ToString("dd-MMM-yyyy")

                                </td>

                                <td>

                                    @item.TimeSlot

                                </td>

                                <td>

                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">

                                            Pending

                                        </span>
                                    }
                                    else if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-primary">

                                            Approved

                                        </span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-success">

                                            Completed

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">

                                            Declined

                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (item.Status == "Pending")
                                    {
                                        <form asp-action="ApproveAppointment"
                                              method="post"
                                              style="display:inline;">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button class="btn btn-outline-success btn-sm">

                                                <i class="bi bi-check-lg"></i>

                                            </button>

                                        </form>

                                        <form asp-action="DeclineAppointment"
                                              method="post"
                                              style="display:inline;">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button class="btn btn-outline-danger btn-sm">

                                                <i class="bi bi-x-lg"></i>

                                            </button>

                                        </form>
                                    }

                                    @if (item.Status == "Approved")
                                    {
                                        <a asp-controller="PatientEntry"
                                           asp-action="Create"
                                           asp-route-patientCode="@item.PatientCode"
                                           asp-route-appointmentId="@item.Id"
                                           class="btn btn-primary btn-sm">

                                            <i class="bi bi-person-plus me-1"></i>

                                            Patient Entry

                                        </a>
                                    }

                                    @if (item.Status == "Completed")
                                    {
                                        <span class="text-success fw-semibold">

                                            <i class="bi bi-check-circle-fill me-1"></i>

                                            Completed

                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center text-muted py-4">

                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>

                                No appointments found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

   

@section Scripts
{
    <script>
        setTimeout(function () {
            $(".auto-alert").fadeOut("slow");
        }, 3000);
    </script>
}