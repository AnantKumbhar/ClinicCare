@{
    Layout = "_DashboardLayout";
}
<h2>Doctor Dashboard</h2>

<div class="row">

    <div class="col-md-3">

        <div class="card text-center">

            <div class="card-body">

                <h5>Today's Patients</h5>

                <h2>@Model.TodayPatients</h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-center">

            <div class="card-body">

                <h5>Today's Collection</h5>

                <h2>₹ @Model.TodayCollection</h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-center">

            <div class="card-body">

                <h5>Total Patients</h5>

                <h2>@Model.TotalPatients</h2>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card text-center">

            <div class="card-body">

                <h5>Total Visits</h5>

                <h2>@Model.TotalVisits</h2>

            </div>

        </div>

    </div>


</div>

<br />

<div class="card">

    <div class="card-header">

        <h5>Low Stock Medicines</h5>

    </div>

    <div class="card-body">

        <table class="table table-bordered">

            <thead>

                <tr>

                    <th>Medicine</th>

                    <th>Stock</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var medicine in Model.LowStockMedicines)
                {
                    <tr>

                        <td>
                            @medicine.MedicineName
                        </td>

                        <td>
                            @medicine.StockQuantity
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<br />

<div class="card">

    <div class="card-header">

        <h5>Expiring Medicines (Next 30 Days)</h5>

    </div>

    <div class="card-body">

        <table class="table table-bordered">

            <thead>

                <tr>

                    <th>Medicine</th>

                    <th>Expiry Date</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var medicine in Model.ExpiringMedicines)
                {
                    <tr>

                        <td>
                            @medicine.MedicineName
                        </td>

                        <td>
                            @medicine.ExpiryDate.ToString("dd-MMM-yyyy")
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>