@model ClinicCare.ViewModels.DashboardViewModel

@{
    Layout = "_DashboardLayout";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success toast-message auto-alert">

        @TempData["Success"]

    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger toast-message auto-alert">

        @TempData["Error"]

    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="mb-0">
            Compounder Dashboard
        </h2>

        <small class="text-muted">

            Clinic overview and statistics

        </small>

    </div>

</div>

<div class="row">

    <div class="col-md-3">

        <div class="card dashboard-card card-primary text-center">

            <div class="card-body">
                <i class="bi bi-people dashboard-icon text-primary"></i>

                <h6>Today's Patients</h6>

                <div class="dashboard-number">
                    @Model.TodayPatients
                </div>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card dashboard-card card-success text-center">
            <div class="card-body">

                <i class="bi bi-cash-stack dashboard-icon text-success"></i>

                <h6>Today's Collection</h6>

                <div class="dashboard-number">
                    ₹ @Model.TodayCollection
                </div>

            </div>
        </div>

    </div>

    <div class="col-md-3">

        <div class="card dashboard-card card-primary text-center">

            <div class="card-body">
                <i class="bi bi-person-vcard dashboard-icon text-primary"></i>

                <h6>Total Patients</h6>
                <div class="dashboard-number">
                    @Model.TotalPatients
                </div>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card dashboard-card card-primary text-center">

            <div class="card-body">
                <i class="bi bi-journal-medical dashboard-icon text-warning"></i>

                <h6>Total Visits</h6>

                <div class="dashboard-number">
                    @Model.TotalVisits
                </div>

            </div>

        </div>

    </div>


</div>

<br />

<div class="card">

    <div class="card-header">

        <i class="bi bi-exclamation-triangle text-danger me-2"></i>

        Low Stock Medicines

    </div>

    <div class="card-body">

        <table class="table table-hover align-middle">

            <thead>

                <tr>

                    <th>Medicine</th>

                    <th>Stock</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var medicine in Model.LowStockMedicines)
                {
                    <tr>

                        <td>
                            @medicine.MedicineName
                        </td>

                        <td>
                            <span class="badge bg-danger">

                                @medicine.StockQuantity

                            </span>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<br />

<div class="card">

    <div class="card-header">

        <i class="bi bi-clock-history text-warning me-2"></i>

        Expiring Medicines (Next 30 Days)

    </div>

    <div class="card-body">

        <table class="table table-hover align-middle">

            <thead>

                <tr>

                    <th>Medicine</th>

                    <th>Expiry Date</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var medicine in Model.ExpiringMedicines)
                {
                    <tr>

                        <td>
                            @medicine.MedicineName
                        </td>

                        <td>

                            <span class="badge bg-warning text-dark">

                                @medicine.ExpiryDate.ToString("dd-MMM-yyyy")

                            </span>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>