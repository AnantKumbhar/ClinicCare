@model ClinicCare.ViewModels.ExpenseViewModel

@{
    Layout = "_DashboardLayout";
}

<h2>Add Expense</h2>

<form method="post">

    <div class="row">

        <div class="col-md-6">

            <label>Expense Category</label>

            <select asp-for="ExpenseCategoryId"
                    asp-items="Model.Categories"
                    class="form-control">

                <option value="">
                    Select Category
                </option>

            </select>

            <span asp-validation-for="ExpenseCategoryId"
                  class="text-danger">
            </span>

        </div>

        <div class="col-md-6">

            <label>Amount</label>

            <input asp-for="Amount"
                   class="form-control" />

            <span asp-validation-for="Amount"
                  class="text-danger">
            </span>

        </div>

    </div>

    <br />

    <div class="row">

        <div class="col-md-6">

            <label>Expense Date</label>

            <input asp-for="ExpenseDate"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="ExpenseDate"
                  class="text-danger">
            </span>

        </div>

    </div>

    <br />

    <div>

        <label>Notes</label>

        <textarea asp-for="Notes"
                  class="form-control"
                      rows="3">
        </textarea>

        </div>

        <br />

        <button type="submit"
                class="btn btn-success">

            Save Expense

        </button>

        <a asp-action="Index"
               class="btn btn-secondary">

            Back

        </a>

    </form>

    @section Scripts
    {
        <partial name="_ValidationScriptsPartial" />
    }