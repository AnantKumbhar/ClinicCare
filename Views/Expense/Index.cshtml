@model dynamic

@{
    Layout = "_DashboardLayout";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


<div class="row mb-3">

    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5>Total Expenses</h5>
                <h3>₹ @ViewBag.TotalExpense</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5>This Month</h5>
                <h3>₹ @ViewBag.MonthExpense</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5>Today</h5>
                <h3>₹ @ViewBag.TodayExpense</h3>
            </div>
        </div>
    </div>

</div>

<div class="d-flex justify-content-between mb-3">

    <h2>Expenses</h2>

    <a asp-action="Create"
           class="btn btn-success">
        Add Expense
    </a>

</div>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Date</th>
            <th>Category</th>
            <th>Amount</th>
            <th>Notes</th>
            <th>Type</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.ExpenseDate.ToString("dd-MMM-yyyy")
                </td>

                <td>
                    @item.CategoryName
                </td>

                <td>
                    ₹ @item.Amount
                </td>

                <td>
                    @item.Notes
                </td>
                <td>
                    @(item.IsSystemGenerated
                        ? "Auto"
                        : "Manual")
                </td>

                <td>

                    <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <form asp-action="Delete"
                          method="post"
                          style="display:inline;">

                        <input type="hidden"
                               name="id"
                               value="@item.Id" />

                        <button class="btn btn-danger btn-sm"
                                onclick="return confirm('Delete this expense?')">
                            Delete
                        </button>

                    </form>

                </td>

            </tr>
        }

    </tbody>

</table>