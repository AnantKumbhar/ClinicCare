@model dynamic

@{
    Layout = "_DashboardLayout";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success auto-alert">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger auto-alert">
        @TempData["Error"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="mb-0">
            <i class="bi bi-receipt me-2"></i>
            Expenses
        </h2>

        <small class="text-muted">
            Track clinic expenses and operating costs
        </small>

    </div>

    <a asp-action="Create"
       class="btn btn-success">

        Add Expense

    </a>

</div>

<div class="row g-3 mb-4">

    <div class="col-md-4">

        <div class="card dashboard-card card-danger">

            <div class="card-body text-center">

                <i class="bi bi-cash-stack dashboard-icon text-danger"></i>

                <h6>Total Expenses</h6>

                <div class="dashboard-number">

                    ₹ @ViewBag.TotalExpense

                </div>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card dashboard-card card-warning">

            <div class="card-body text-center">

                <i class="bi bi-calendar-month dashboard-icon text-warning"></i>

                <h6>This Month</h6>

                <div class="dashboard-number">

                    ₹ @ViewBag.MonthExpense

                </div>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card dashboard-card card-primary">

            <div class="card-body text-center">

                <i class="bi bi-calendar-day dashboard-icon text-primary"></i>

                <h6>Today</h6>

                <div class="dashboard-number">

                    ₹ @ViewBag.TodayExpense

                </div>

            </div>

        </div>

    </div>

</div>



        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Date</th>

                        <th>Category</th>

                        <th>Amount</th>

                        <th>Notes</th>

                        <th>Type</th>

                        <th width="180">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model != null)
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    @item.ExpenseDate.ToString("dd-MMM-yyyy")

                                </td>

                                <td>

                                    <span class="badge bg-info text-dark">

                                        @item.CategoryName

                                    </span>

                                </td>

                                <td class="fw-bold text-danger">

                                    ₹ @item.Amount

                                </td>

                                <td>

                                    @(string.IsNullOrWhiteSpace(item.Notes)
                                        ? "-"
                                        : item.Notes)

                                </td>

                                <td>

                                    @if (item.IsSystemGenerated)
                                    {
                                        <span class="badge bg-secondary">

                                            Auto

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">

                                            Manual

                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (!item.IsSystemGenerated)
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm">

                                            Edit

                                        </a>

                                        <form asp-action="Delete"
                                              method="post"
                                              style="display:inline;">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Delete this expense?')">

                                                Delete

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            Locked

                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center text-muted py-4">

                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>

                                No expense records found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

 

@section Scripts
{
    <script>
        setTimeout(function () {
            $(".auto-alert").fadeOut("slow");
        }, 3000);
    </script>
}