@model ClinicCare.Models.MedicineCategory

@{
    Layout = "_DashboardLayout";
}

<h2>Edit Category</h2>

<form method="post">

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">

        <label>Category Name</label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger"></span>

    </div>

    <button class="btn btn-primary">
        Update
    </button>

</form>