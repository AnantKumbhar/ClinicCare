@model List<ClinicCare.ViewModels.MedicinePurchaseHistoryViewModel>

@{
    Layout = "_DashboardLayout";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success auto-alert">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger auto-alert">
        @TempData["Error"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="mb-0">
            <i class="bi bi-clock-history me-2"></i>
            Medicine Purchase History
        </h2>

        <small class="text-muted">
            Track all medicine stock purchases
        </small>

    </div>

</div>

<div class="row g-3 mb-4">

    <div class="col-md-3">

        <div class="card dashboard-card card-primary">

            <div class="card-body text-center">

                <i class="bi bi-bag-check dashboard-icon text-primary"></i>

                <h6>Total Purchases</h6>

                <div class="dashboard-number">

                    @ViewBag.TotalPurchases

                </div>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card dashboard-card card-success">

            <div class="card-body text-center">

                <i class="bi bi-cash-stack dashboard-icon text-success"></i>

                <h6>Total Amount</h6>

                <div class="dashboard-number">

                    ₹ @ViewBag.TotalAmount

                </div>

            </div>

        </div>

    </div>

</div>



    
        

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Date</th>

                        <th>Medicine</th>

                        <th>Quantity</th>

                        <th>Amount</th>

                        <th>Invoice No.</th>

                        <th width="180">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.PurchaseDate.ToString("dd-MMM-yyyy")
                                </td>

                                <td class="fw-semibold">
                                    @item.MedicineName
                                </td>

                                <td>

                                    <span class="badge bg-primary">

                                        @item.QuantityPurchased

                                    </span>

                                </td>

                                <td class="fw-bold text-success">

                                    ₹ @item.PurchaseAmount

                                </td>

                                <td>

                                    @(string.IsNullOrWhiteSpace(item.InvoiceNumber)
                                        ? "-"
                                        : item.InvoiceNumber)

                                </td>

                                <td>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">

                                       Edit 

                                    </a>

                                    <form asp-action="Delete"
                                          method="post"
                                          style="display:inline;">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Delete this purchase?')">

                                            Delete

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center text-muted py-4">

                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>

                                No purchase records found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

   

@section Scripts
{
    <script>
        setTimeout(function () {
            $(".auto-alert").fadeOut("slow");
        }, 3000);
    </script>
}