@model List<ClinicCare.ViewModels.MedicinePurchaseHistoryViewModel>

@{
    Layout = "_DashboardLayout";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="alert alert-info">

    Total Purchases :
    @ViewBag.TotalPurchases

    <br />

    Total Amount :
    ₹ @ViewBag.TotalAmount

</div>

<h2>Medicine Purchase History</h2>

<table class="table table-bordered">

    <thead>

        <tr>

            <th>Date</th>

            <th>Medicine</th>

            <th>Quantity</th>

            <th>Amount</th>

            <th>Invoice</th>

            <th>Action</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.PurchaseDate.ToString("dd-MMM-yyyy")
                </td>

                <td>
                    @item.MedicineName
                </td>

                <td>
                    @item.QuantityPurchased
                </td>

                <td>
                    ₹ @item.PurchaseAmount
                </td>

                <td>
                    @item.InvoiceNumber
                </td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <form asp-action="Delete"
                          method="post"
                          style="display:inline;">

                        <input type="hidden"
                               name="id"
                               value="@item.Id" />

                        <button class="btn btn-danger btn-sm"
                                onclick="return confirm('Delete this purchase?')">

                            Delete

                        </button>

                    </form>

                </td>

            </tr>
        }

    </tbody>

</table>