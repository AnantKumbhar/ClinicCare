@{
    Layout = "_PatientLayout";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success auto-alert">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger auto-alert">
        @TempData["Error"]
    </div>
}

<div class="mb-4">

    <h2 class="mb-1">

        Welcome,
        @ViewBag.PatientName 👋

    </h2>

    <p class="text-muted mb-0">

        Manage appointments and view your clinic visit history.

    </p>

</div>

<div class="row g-3 mb-4">

    <div class="col-md-6">

        <div class="card border-opacity-50  shadow-sm">

            <div class="card-body text-center">

                

                <h6 class="mt-2">
                    Total Visits
                </h6>

                <h5 class="fw-bold">

                    @ViewBag.TotalVisits

                </h5>

            </div>

        </div>

    </div>

    <div class="col-md-6">

        <div class="card border-opacity-50 shadow-sm">

            <div class="card-body text-center">

               

                <h6 class="mt-2">
                    Last Visit
                </h6>

                <h5 class="fw-bold">

                    @(ViewBag.LastVisit == DateTime.MinValue
                        ? "No Visits Yet"
                        : ((DateTime)ViewBag.LastVisit)
                            .ToString("dd-MMM-yyyy"))

                </h5>

            </div>

        </div>

    </div>

</div>



    <div class="card-header bg-white">

        <h5 class="mb-0">

            <i class="bi bi-calendar-plus me-2"></i>

            Book Appointment

        </h5>

    </div>

    <hr />

        <form asp-action="BookAppointment"
              method="post">

            <div class="row g-3 align-items-end">

                <div class="col-md-4">

                    <label class="form-label">

                        Appointment Date

                    </label>

                    <input type="date"
                           name="AppointmentDate"
                           class="form-control" />

                </div>

                <div class="col-md-4">

                    <label class="form-label">

                        Time Slot

                    </label>

                    <select name="TimeSlot"
                            class="form-select">

                        <option value="">
                            Select Slot
                        </option>

                        @foreach (var slot in ViewBag.Slots)
                        {
                            <option value="@slot.Value">

                                @slot.Text

                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-4">

                    <button type="submit"
                            class="btn btn-success w-100">


                        Book Appointment

                    </button>

                </div>

            </div>

        </form>

   
        <p />


    <div class="card-header bg-white">

        <h5 class="mb-0">

            <i class="bi bi-clock-history me-2"></i>

            My Recent Appointments

        </h5>

    </div>
    <hr />

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Date</th>

                        <th>Time Slot</th>

                        <th>Status</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in ViewBag.RecentAppointments)
                    {
                        <tr>

                            <td>
                                @item.AppointmentDate.ToString("dd-MMM-yyyy")
                            </td>

                            <td>
                                @item.TimeSlot
                            </td>

                            <td>

                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">

                                        Pending

                                    </span>
                                }
                                else if (item.Status == "Approved")
                                {
                                    <span class="badge bg-primary">

                                        Approved

                                    </span>
                                }
                                else if (item.Status == "Completed")
                                {
                                    <span class="badge bg-success">

                                        Completed

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">

                                        Declined

                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    

@section Scripts
{
    <script>

        setTimeout(function () {

            $(".auto-alert").fadeOut("slow");

        }, 3000);

    </script>
}