@{
    Layout = "_PatientLayout";
}

<h2>

    Welcome,

    @ViewBag.PatientName

</h2>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<hr />

<div class="row">

    <div class="col-md-6">

        <div class="card">

            <div class="card-body text-center">

                <h5>Total Visits</h5>

                <h2>

                    @ViewBag.TotalVisits

                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-6">

        <div class="card">

            <div class="card-body text-center">

                <h5>Last Visit</h5>

                <h2>

                    @(ViewBag.LastVisit == DateTime.MinValue
                        ? "No Visits"
                        : ((DateTime)ViewBag.LastVisit)
                            .ToString("dd-MMM-yyyy"))

                </h2>

            </div>

        </div>

    </div>
    <h4 class="mt-4">
        Book Appointment
    </h4>

    <form asp-action="BookAppointment"
          method="post">

        <div class="row">

            <div class="col-md-4">

                <label>Date</label>

                <input type="date"
                       name="AppointmentDate"
                       class="form-control" />

            </div>

            <div class="col-md-4">

                <label>Slot</label>

                <select name="TimeSlot"
                        class="form-control">

                    <option value="">
                        Select Slot
                    </option>

                    @foreach (var slot in ViewBag.Slots)
                    {
                        <option value="@slot.Value">
                            @slot.Text
                        </option>
                    }

                </select>

            </div>

            <div class="col-md-4">

                <br />

                <button type="submit"
                        class="btn btn-success">

                    Book Appointment

                </button>

            </div>

        </div>

    </form>
    <h4 class="mt-4">
        My Recent Appointments
    </h4>

    <table class="table table-bordered">

        <thead>

            <tr>

                <th>Date</th>

                <th>Slot</th>

                <th>Status</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in ViewBag.RecentAppointments)
            {
                <tr>

                    <td>
                        @item.AppointmentDate.ToString("dd-MMM-yyyy")
                    </td>

                    <td>
                        @item.TimeSlot
                    </td>

                    <td>

                        @if (item.Status == "Pending")
                        {
                            <span class="badge bg-warning">
                                Pending
                            </span>
                        }
                        else if (item.Status == "Approved")
                        {
                            <span class="badge bg-primary">
                                Approved
                            </span>
                        }
                        else if (item.Status == "Completed")
                        {
                            <span class="badge bg-success">
                                Completed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Declined
                            </span>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>