@model ClinicCare.ViewModels.PatientProfileViewModel

@{
    Layout = "_PatientLayout";
}

<h2>My Profile</h2>

<hr />

<div class="card">

    <div class="card-body">

        <div class="row mb-3">

            <div class="col-md-6">

                <label>Patient Code</label>

                <input class="form-control"
                       value="@Model.PatientCode"
                       readonly />

            </div>

            <div class="col-md-6">

                <label>Full Name</label>

                <input class="form-control"
                       value="@Model.FullName"
                       readonly />

            </div>

        </div>

        <div class="row mb-3">

            <div class="col-md-6">

                <label>Date Of Birth</label>

                <input class="form-control"
                       value="@Model.DateOfBirth.ToString("dd-MMM-yyyy")"
                       readonly />

            </div>

            <div class="col-md-6">

                <label>Gender</label>

                <input class="form-control"
                       value="@Model.Gender"
                       readonly />

            </div>

        </div>

        <div class="row">

            <div class="col-md-6">

                <label>Mobile Number</label>

                <input class="form-control"
                       value="@Model.MobileNumber"
                       readonly />

            </div>

        </div>

    </div>

</div>