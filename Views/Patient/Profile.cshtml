@model ClinicCare.ViewModels.PatientProfileViewModel

@{
    Layout = "_PatientLayout";
}

<div class="mb-4">

    <h2 class="mb-1">
        My Profile
    </h2>

    <p class="text-muted mb-0">
        View your personal information registered with ClinicCare.
    </p>

</div>



        

        <div class="row g-4">

            <div class="col-md-6">

                <div class="border rounded p-3 h-100">

                    <small class="text-muted d-block">
                        Patient Code
                    </small>

                    <div class="fw-semibold">
                        @Model.PatientCode
                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <div class="border rounded p-3 h-100">

                    <small class="text-muted d-block">
                        Full Name
                    </small>

                    <div class="fw-semibold">
                        @Model.FullName
                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <div class="border rounded p-3 h-100">

                    <small class="text-muted d-block">
                        Date Of Birth
                    </small>

                    <div class="fw-semibold">
                        @Model.DateOfBirth.ToString("dd-MMM-yyyy")
                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <div class="border rounded p-3 h-100">

                    <small class="text-muted d-block">
                        Gender
                    </small>

                    <div class="fw-semibold">
                        @Model.Gender
                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <div class="border rounded p-3 h-100">

                    <small class="text-muted d-block">
                        Mobile Number
                    </small>

                    <div class="fw-semibold">
                        @Model.MobileNumber
                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <div class="border rounded p-3 h-100">

                    <small class="text-muted d-block">
                        Total Visits
                    </small>

                    <div class="fw-semibold">
                        @Model.TotalVisits
                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <div class="border rounded p-3 h-100">

                    <small class="text-muted d-block">
                        Last Visit
                    </small>

                    <div class="fw-semibold">

                        @(Model.LastVisitDate == null
                            ? "No Visits Yet"
                            : Model.LastVisitDate.Value.ToString("dd-MMM-yyyy"))

                    </div>

                </div>

            </div>

        </div>

        