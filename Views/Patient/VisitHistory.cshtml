@model List<ClinicCare.ViewModels.VisitHistoryViewModel>

@{
    Layout = "_PatientLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="mb-1">
            My Visit History
        </h2>

        <p class="text-muted mb-0">
            View all your clinic visits and consultation records.
        </p>

    </div>

</div>

<div class="row g-3 mb-4">

    <div class="col-md-4">

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center">

                <i class="bi bi-journal-medical text-primary fs-1"></i>

                <h6 class="mt-2">
                    Total Visits
                </h6>

                <h5 class="fw-bold">

                    @Model.Count

                </h5>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center">

                <i class="bi bi-cash-stack text-success fs-1"></i>

                <h6 class="mt-2">
                    Total Amount Paid
                </h6>

                <h5 class="fw-bold">

                    ₹ @Model.Sum(x => x.AmountPaid)

                </h5>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center">

                <i class="bi bi-calendar-check text-info fs-1"></i>

                <h6 class="mt-2">
                    Last Visit
                </h6>

                <h5 class="fw-bold">

                    @(Model.Any()
                        ? Model.Max(x => x.VisitDate).ToString("dd-MMM-yyyy")
                        : "No Visits")

                </h5>

            </div>

        </div>

    </div>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-header bg-white">

        <h5 class="mb-0">

            <i class="bi bi-clock-history me-2"></i>

            Visit Records

        </h5>

    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Visit No</th>

                        <th>Date</th>

                        <th>Disease</th>

                        <th>Amount</th>

                        <th width="180">
                            Action
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <span class="badge bg-primary">

                                        @item.VisitNumber

                                    </span>

                                </td>

                                <td>

                                    @item.VisitDate.ToString("dd-MMM-yyyy")

                                </td>

                                <td>

                                    @item.Disease

                                </td>

                                <td class="fw-bold text-success">

                                    ₹ @item.AmountPaid

                                </td>

                                <td>

                                    <a asp-action="VisitDetails"
                                       asp-route-id="@item.VisitId"
                                       class="btn btn-outline-primary btn-sm">

                                        <i class="bi bi-eye me-1"></i>

                                        View Details

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5"
                                class="text-center text-muted py-4">

                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>

                                No visit records found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>