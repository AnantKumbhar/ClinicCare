@model ClinicCare.ViewModels.PatientEntryViewModel

@{
    Layout = "_DashboardLayout";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success toast-message alert-dismissible fade show auto-alert">

        @TempData["Success"]

    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger toast-message alert-dismissible fade show auto-alert">

        @TempData["Error"]

    </div>
}
<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="mb-0">
            Patient Entry
        </h2>

        <small class="text-muted">
            Register patient visit and prescribe medicines
        </small>

    </div>

</div>

<form method="post">

        <input asp-for="AppointmentId" type="hidden" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All"
                 class="alert alert-danger">
            </div>
        }

        <!-- Patient Information -->

        

            <div class="card-header bg-white">

                <h5 class="mb-0">

                    <i class="bi bi-person-vcard me-2"></i>

                    Patient Information

                </h5>

            </div>
            <hr />
            

                <div class="row g-3">

                    <div class="col-md-4">

                        <label class="fw-semibold">
                            Patient ID
                        </label>

                        <input asp-for="PatientCode"
                               id="patientSearch"
                               autocomplete="off"
                               class="form-control" />

                        <div id="patientSuggestions"
                             class="list-group position-absolute w-100"
                             style="z-index:1000;">
                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="fw-semibold">
                            Full Name
                        </label>

                        <input asp-for="FullName"
                               id="fullName"
                               class="form-control" />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4">

                        <label class="fw-semibold">
                            Date Of Birth
                        </label>

                        <input asp-for="DateOfBirth"
                               id="dateOfBirth"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="DateOfBirth"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-2">

                        <label class="fw-semibold">
                            Age
                        </label>

                        <div class="form-control text-center fw-bold bg-light"
                             id="ageDisplay">

                            -

                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="fw-semibold">
                            Gender
                        </label>

                        <select asp-for="Gender"
                                id="gender"
                                class="form-control">

                            <option value="">
                                Select
                            </option>

                            <option>
                                Male
                            </option>

                            <option>
                                Female
                            </option>

                        </select>

                        <span asp-validation-for="Gender"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4">

                        <label class="fw-semibold">
                            Mobile Number
                        </label>

                        <input asp-for="MobileNumber"
                               id="mobileNumber"
                               class="form-control" />

                        <span asp-validation-for="MobileNumber"
                              class="text-danger">
                        </span>

                    </div>

               

        </div>

        <!-- Visit Information -->

        <hr />

            <div class="card-header bg-white">

                <h5 class="mb-0">

                    <i class="bi bi-journal-medical me-2"></i>

                    Visit Information

                </h5>

            </div>
             <hr />
            

                <div class="row g-3">

                    <div class="col-md-4">

                        <label class="fw-semibold">
                            Disease Category
                        </label>

                        <select asp-for="DiseaseCategoryId"
                                asp-items="Model.DiseaseCategories"
                                class="form-control">

                            <option value="">
                                Select Disease
                            </option>

                        </select>

                        <span asp-validation-for="DiseaseCategoryId"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4">

                        <label class="fw-semibold">
                            Amount Paid
                        </label>

                        <input asp-for="AmountPaid"
                               class="form-control" />

                        <span asp-validation-for="AmountPaid"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            
        

        <!-- Medicines -->
            <hr />
        

            <div class="card-header bg-white">

                <h5 class="mb-0">

                    <i class="bi bi-capsule-pill me-2"></i>

                    Medicines

                </h5>

            </div>

            <hr />

                <div class="row g-3 align-items-end">

                    <div class="col-md-5">

                        <label class="fw-semibold">
                            Medicine
                        </label>

                        <select id="medicineDropdown"
                                class="form-control">

                            <option value="">
                                Select Medicine
                            </option>

                            @foreach (var medicine in Model.MedicineOptions)
                            {
                                <option value="@medicine.Value">
                                    @medicine.Text
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-3">

                        <label class="fw-semibold">
                            Quantity
                        </label>

                        <input type="number"
                               id="medicineQty"
                               min="1"
                               class="form-control" />

                    </div>

                    <div class="col-md-2">

                        <button type="button"
                                id="addMedicineBtn"
                                class="btn btn-primary w-100">

                            <i class="bi bi-plus-circle me-1"></i>

                            Add

                        </button>

                    </div>

                </div>

                <p />
                <table class="table table-hover align-middle "
                       id="medicineTable">

                    <thead class="table-light">

                        <tr>

                            <th>Medicine</th>

                            <th>Quantity</th>

                            <th width="120">
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>
                    </tbody>

                </table>

                <div id="hiddenMedicineInputs">
                </div>

            


        <!-- Notes -->

            <hr />

            <div class="card-header bg-white">

                <h5 class="mb-0">

                    <i class="bi bi-card-text me-2"></i>

                    Notes

                </h5>

            </div>

            <hr />

                <textarea asp-for="Notes"
                          rows="4"
                          class="form-control">
        </textarea>

        
        <p />
        <!-- Save Button -->

        <div class="text-start">

        <button class="btn btn-primary">

                <i class="bi bi-check-circle me-2"></i>

                Save Entry

            </button>

        </div>
        

    </form>


    @section Scripts
    {
        <script>
                 setTimeout(function () {

            $(".auto-alert").fadeOut("slow");

        }, 3000);

            $("#patientSearch").on("input", function () {

                let term = $(this).val();

                if (term.length < 1)
                {
                    $("#patientSuggestions").empty();
                    return;
                }

                $.get('/PatientEntry/SearchPatients',
                    { term: term },
                    function (data)
                    {
                        let html = '';

                        data.forEach(function(patient)
                        {
                            html += `
                                <a href="#"
                                   class="list-group-item patient-item"
                                   data-id="${patient.patientCode}">
                                   ${patient.patientCode}
                                   -
                                   ${patient.fullName}
                                   -
                                   ${patient.mobileNumber}
                                </a>
                            `;
                        });

                        $("#patientSuggestions").html(html);
                    });
            });

            $(document).on('click',
                '.patient-item',
                function(e)
                {
                    e.preventDefault();

                    let patientCode =
                        $(this).data('id');

                    $.get('/PatientEntry/GetPatientDetails',
                        { patientCode: patientCode },
                        function(patient)
                        {
                            $("#patientSearch")
                                .val(patient.patientCode);

                            $("#fullName")
                                .val(patient.fullName);

                            $("#dateOfBirth")
                                .val(patient.dateOfBirth.substring(0,10));

                            $("#ageDisplay").text("-");

                            calculateAge(patient.dateOfBirth);

                            $("#gender")
                                .val(patient.gender);

                            $("#mobileNumber")
                                .val(patient.mobileNumber);
                            
                            $("#fullName").prop("readonly", true);

                            $("#dateOfBirth").prop("readonly", true);

                            $("#mobileNumber").prop("readonly", true);

                            $("#gender").css("pointer-events", "none");

                            $("#patientSuggestions")
                                .empty();
                        });
                });

                        $("#patientSearch").on("input", function () {

                if ($(this).val().trim() === "")
                {
                    $("#fullName").prop("readonly", false);

                    $("#dateOfBirth").prop("readonly", false);

                    $("#mobileNumber").prop("readonly", false);

                    $("#gender").prop("disabled", false);

                    $("#fullName").val("");

                    $("#dateOfBirth").val("");

                    $("#mobileNumber").val("");

                    $("#gender").val("");
                }
            });
            function calculateAge(dateOfBirth)
            {
                let dob = new Date(dateOfBirth);

                let today = new Date();

                let age = today.getFullYear()
                    - dob.getFullYear();

                let month =
                    today.getMonth() - dob.getMonth();

                if (
                    month < 0 ||
                    (month === 0 &&
                    today.getDate() < dob.getDate())
                )
                {
                    age--;
                }

                $("#ageDisplay").text(age + " Years");
            }
                        let medicineIndex = 0;

            $("#addMedicineBtn").click(function ()
            {
                let medicineId =
                    $("#medicineDropdown").val();

                let medicineName =
                    $("#medicineDropdown option:selected").text();

                let quantity =
                    $("#medicineQty").val();

                if (!medicineId || quantity <= 0)
                {
                    alert("Select medicine and quantity");

                    return;
                }

                let row = `
                    <tr id="row-${medicineIndex}">

                        <td>${medicineName}</td>

                        <td>${quantity}</td>

                        <td>

                            <button type="button"
                                    class="btn btn-danger btn-sm removeMedicine"
                                    data-row="${medicineIndex}">
                                Remove
                            </button>

                        </td>

                    </tr>
                `;

                $("#medicineTable tbody")
                    .append(row);

                let hiddenInputs = `
                <div id="hidden-${medicineIndex}">
                    <input type="hidden"
                           name="Medicines[${medicineIndex}].MedicineId"
                           value="${medicineId}" />

                    <input type="hidden"
                           name="Medicines[${medicineIndex}].Quantity"
                           value="${quantity}" />
                </div>
                `;

                $("#hiddenMedicineInputs")
                    .append(hiddenInputs);

                medicineIndex++;

                $("#medicineDropdown").val("");

                $("#medicineQty").val("");
            });

            $(document).on("click",
                ".removeMedicine",
                function ()
                {
                    let rowId =
                        $(this).data("row");

                    $("#row-" + rowId)
                        .remove();
                    $("#hidden-" + rowId)
                        .remove();
                });
        </script>
    }