@model ClinicCare.ViewModels.PatientEntryViewModel

@{
    Layout = "_DashboardLayout";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<h2>Patient Entry</h2>

<form method="post">
    <input asp-for="AppointmentId"
           type="hidden" />

    <div class="row">
        <div asp-validation-summary="All"
             class="text-danger">
        </div>

        <div class="col-md-4">
            <label>Patient ID</label>
            <input asp-for="PatientCode"
                   id="patientSearch"
                   autocomplete="off"
                   class="form-control" />

            <div id="patientSuggestions"
                 class="list-group">
            </div>
        </div>

        <div class="col-md-4">
            <label>Full Name</label>
            <input asp-for="FullName" id="fullName" class="form-control" />
        </div>
        <span asp-validation-for="FullName"
              class="text-danger"></span>

        <div class="col-md-4">
            <label>Date Of Birth</label>
            <input asp-for="DateOfBirth"
                   id="dateOfBirth"
                   type="date"
                   class="form-control" />
        </div>
        <span asp-validation-for="DateOfBirth"
              class="text-danger"></span>
        <div class="col-md-2">

            <label>Age</label>

            <div class="form-control bg-light"
                 id="ageDisplay">
                -
            </div>

        </div>

    </div>

    <br />

    <div class="row">

        <div class="col-md-4">
            <label>Gender</label>
            <select asp-for="Gender" id="gender" class="form-control">
                <option value="">Select</option>
                <option>Male</option>
                <option>Female</option>
            </select>
        </div>
        <span asp-validation-for="Gender"
              class="text-danger"></span>

        <div class="col-md-4">
            <label>Mobile Number</label>
            <input asp-for="MobileNumber" id="mobileNumber"
                   class="form-control" />
        </div>
        <span asp-validation-for="MobileNumber"
              class="text-danger"></span>

    </div>

    <br />

    <div class="row">

        <div class="col-md-4">

            <label>Disease Category</label>

            <select asp-for="DiseaseCategoryId"
                    asp-items="Model.DiseaseCategories"
                    class="form-control">

                <option value="">
                    Select Disease
                </option>

            </select>
            <span asp-validation-for="DiseaseCategoryId"
                  class="text-danger"></span>

        </div>

        <div class="col-md-4">
            <label>Amount</label>
            <input asp-for="AmountPaid"
                   class="form-control" />
        </div>
        <span asp-validation-for="AmountPaid"
              class="text-danger"></span>

    </div>

    <br />
    <hr />

    <h4>Medicines</h4>

    <div class="row">

        <div class="col-md-5">

            <label>Medicine</label>

            <select id="medicineDropdown"
                    class="form-control">

                <option value="">
                    Select Medicine
                </option>

                @foreach (var medicine in Model.MedicineOptions)
                {
                    <option value="@medicine.Value">
                        @medicine.Text
                    </option>
                }

            </select>

        </div>

        <div class="col-md-3">

            <label>Quantity</label>

            <input type="number"
                   id="medicineQty"
                   min="1"
                   class="form-control" />

        </div>

        <div class="col-md-2">

            <label>&nbsp;</label>

            <button type="button"
                    id="addMedicineBtn"
                    class="btn btn-success form-control">

                Add

            </button>

        </div>

    </div>

    <br />

    <table class="table table-bordered"
           id="medicineTable">

        <thead>

            <tr>

                <th>Medicine</th>

                <th>Quantity</th>

                <th>Action</th>

            </tr>

        </thead>

        <tbody>
        </tbody>

    </table>

    <div id="hiddenMedicineInputs">
    </div>

    <div>
        <label>Notes</label>
        <textarea asp-for="Notes"
                      class="form-control">
        </textarea>
        </div>

        <br />

        <button class="btn btn-primary">
            Save Entry
        </button>

    </form>

    @section Scripts
    {
        <script>

            $("#patientSearch").on("input", function () {

                let term = $(this).val();

                if (term.length < 1)
                {
                    $("#patientSuggestions").empty();
                    return;
                }

                $.get('/PatientEntry/SearchPatients',
                    { term: term },
                    function (data)
                    {
                        let html = '';

                        data.forEach(function(patient)
                        {
                            html += `
                                <a href="#"
                                   class="list-group-item patient-item"
                                   data-id="${patient.patientCode}">
                                   ${patient.patientCode}
                                   -
                                   ${patient.fullName}
                                   -
                                   ${patient.mobileNumber}
                                </a>
                            `;
                        });

                        $("#patientSuggestions").html(html);
                    });
            });

            $(document).on('click',
                '.patient-item',
                function(e)
                {
                    e.preventDefault();

                    let patientCode =
                        $(this).data('id');

                    $.get('/PatientEntry/GetPatientDetails',
                        { patientCode: patientCode },
                        function(patient)
                        {
                            $("#patientSearch")
                                .val(patient.patientCode);

                            $("#fullName")
                                .val(patient.fullName);

                            $("#dateOfBirth")
                                .val(patient.dateOfBirth.substring(0,10));

                            $("#ageDisplay").text("-");

                            calculateAge(patient.dateOfBirth);

                            $("#gender")
                                .val(patient.gender);

                            $("#mobileNumber")
                                .val(patient.mobileNumber);
                            
                            $("#fullName").prop("readonly", true);

                            $("#dateOfBirth").prop("readonly", true);

                            $("#mobileNumber").prop("readonly", true);

                            $("#gender").css("pointer-events", "none");

                            $("#patientSuggestions")
                                .empty();
                        });
                });

                        $("#patientSearch").on("input", function () {

                if ($(this).val().trim() === "")
                {
                    $("#fullName").prop("readonly", false);

                    $("#dateOfBirth").prop("readonly", false);

                    $("#mobileNumber").prop("readonly", false);

                    $("#gender").prop("disabled", false);

                    $("#fullName").val("");

                    $("#dateOfBirth").val("");

                    $("#mobileNumber").val("");

                    $("#gender").val("");
                }
            });
            function calculateAge(dateOfBirth)
            {
                let dob = new Date(dateOfBirth);

                let today = new Date();

                let age = today.getFullYear()
                    - dob.getFullYear();

                let month =
                    today.getMonth() - dob.getMonth();

                if (
                    month < 0 ||
                    (month === 0 &&
                    today.getDate() < dob.getDate())
                )
                {
                    age--;
                }

                $("#ageDisplay").text(age + " Years");
            }
                        let medicineIndex = 0;

            $("#addMedicineBtn").click(function ()
            {
                let medicineId =
                    $("#medicineDropdown").val();

                let medicineName =
                    $("#medicineDropdown option:selected").text();

                let quantity =
                    $("#medicineQty").val();

                if (!medicineId || quantity <= 0)
                {
                    alert("Select medicine and quantity");

                    return;
                }

                let row = `
                    <tr id="row-${medicineIndex}">

                        <td>${medicineName}</td>

                        <td>${quantity}</td>

                        <td>

                            <button type="button"
                                    class="btn btn-danger btn-sm removeMedicine"
                                    data-row="${medicineIndex}">
                                Remove
                            </button>

                        </td>

                    </tr>
                `;

                $("#medicineTable tbody")
                    .append(row);

                let hiddenInputs = `
                <div id="hidden-${medicineIndex}">
                    <input type="hidden"
                           name="Medicines[${medicineIndex}].MedicineId"
                           value="${medicineId}" />

                    <input type="hidden"
                           name="Medicines[${medicineIndex}].Quantity"
                           value="${quantity}" />
                </div>
                `;

                $("#hiddenMedicineInputs")
                    .append(hiddenInputs);

                medicineIndex++;

                $("#medicineDropdown").val("");

                $("#medicineQty").val("");
            });

            $(document).on("click",
                ".removeMedicine",
                function ()
                {
                    let rowId =
                        $(this).data("row");

                    $("#row-" + rowId)
                        .remove();
                    $("#hidden-" + rowId)
                        .remove();
                });
        </script>
    }