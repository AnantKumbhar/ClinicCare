@model ClinicCare.ViewModels.PatientProfileViewModel

@{
    Layout = "_DashboardLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="mb-0">
            Patient Profile
        </h2>

        <small class="text-muted">
            Complete patient information and visit history
        </small>

    </div>

</div>

<hr />

    <div class="card-header bg-white">


        <h5 class="mb-0">
            

            <i class="bi bi-person-badge me-2"></i>

            Patient Information

        </h5>

    </div>
    <hr /> 

    <div class="card-body">

        <div class="row g-4">

            <div class="col-md-4">

                <label class="text-muted">
                    Patient Code
                </label>

                <div class="fw-bold">

                    @Model.PatientCode

                </div>

            </div>

            <div class="col-md-4">

                <label class="text-muted">
                    Full Name
                </label>

                <div class="fw-bold">

                    @Model.FullName

                </div>

            </div>

            <div class="col-md-4">

                <label class="text-muted">
                    Gender
                </label>

                <div class="fw-bold">

                    @Model.Gender

                </div>

            </div>

            <div class="col-md-4">

                <label class="text-muted">
                    Mobile Number
                </label>

                <div class="fw-bold">

                    @Model.MobileNumber

                </div>

            </div>

            <div class="col-md-4">

                <label class="text-muted">
                    Date Of Birth
                </label>

                <div class="fw-bold">

                    @Model.DateOfBirth.ToString("dd-MMM-yyyy")

                </div>

            </div>

            <div class="col-md-4">

                <label class="text-muted">
                    Last Visit
                </label>

                <div class="fw-bold">

                    @(Model.LastVisitDate?.ToString("dd-MMM-yyyy") ?? "-")

                </div>

            </div>

        </div>

    </div>

           
    <hr />


    <div class="card-header bg-white">

        <h5 class="mb-0">

            <i class="bi bi-clock-history me-2"></i>

            Visit History 
            <br />

        </h5>

    </div>
    <hr />

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Visit No</th>

                        <th>Disease</th>

                        <th>Amount</th>

                        <th>Date</th>

                        <th width="120">
                            Action
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Visits.Any())
                    {
                        @foreach (var visit in Model.Visits)
                        {
                            <tr>

                                <td>

                                    <span class="badge bg-primary">

                                        @visit.VisitNumber

                                    </span>

                                </td>

                                <td>

                                    <span class="badge bg-info text-dark">

                                        @visit.Disease

                                    </span>

                                </td>

                                <td class="fw-bold text-success">

                                    ₹ @visit.AmountPaid

                                </td>

                                <td>

                                    @visit.VisitDate.ToString("dd-MMM-yyyy")

                                </td>

                                <td>

                                    <a asp-action="VisitDetails"
                                       asp-route-id="@visit.VisitId"
                                       class="btn btn-outline-primary btn-sm">

                                        <i class="bi bi-eye me-1"></i>

                                        View

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5"
                                class="text-center text-muted py-4">

                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>

                                No visit history found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>



<div class="d-flex justify-content-start">

    <a asp-action="VisitHistory"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Back to Visit History

    </a>

</div>