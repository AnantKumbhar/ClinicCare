@model List<ClinicCare.ViewModels.TodayEntriesViewModel>

@{
    Layout = "_DashboardLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="mb-0">
            Today's Entries
        </h2>

        <small class="text-muted">
            Patient visits recorded today
        </small>

    </div>

</div>

<div class="row g-3 mb-4">

    <div class="col-md-3">

        <div class="card dashboard-card card-primary">

            <div class="card-body text-center">

                <i class="bi bi-people dashboard-icon text-primary"></i>

                <h6>Total Patients</h6>

                <div class="dashboard-number">

                    @ViewBag.TotalPatients

                </div>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="card dashboard-card card-success">

            <div class="card-body text-center">

                <i class="bi bi-cash-stack dashboard-icon text-success"></i>

                <h6>Total Collection</h6>

                <div class="dashboard-number">

                    ₹ @ViewBag.TotalCollection

                </div>

            </div>

        </div>

    </div>

</div>

<div class="card shadow-sm border-0">

    <div class="card-header bg-white">

        <h5 class="mb-0">

            <i class="bi bi-clipboard2-pulse me-2"></i>

            Today's Patient Visits

        </h5>

    </div>

    

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Visit No</th>

                        <th>Patient ID</th>

                        <th>Patient Name</th>

                        <th>Disease</th>

                        <th>Amount</th>

                        <th>Time</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <span class="badge bg-primary">

                                        @item.VisitNumber

                                    </span>

                                </td>

                                <td>
                                    @item.PatientCode
                                </td>

                                <td>
                                    @item.PatientName
                                </td>

                                <td>

                                    <span class="badge bg-info text-dark">

                                        @item.Disease

                                    </span>

                                </td>

                                <td class="fw-bold text-success">

                                    ₹ @item.AmountPaid

                                </td>

                                <td>

                                    @item.VisitDate.ToString("hh:mm tt")

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6" class="text-center text-muted py-4">

                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>

                                No patient entries found for today.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    

</div>