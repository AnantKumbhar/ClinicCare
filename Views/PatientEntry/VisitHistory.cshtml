@model List<ClinicCare.ViewModels.VisitHistoryViewModel>

@{
    Layout = "_DashboardLayout";
}

<h2>Visit History</h2>

<table class="table table-bordered">

    <thead>

        <tr>

            <th>Visit No</th>

            <th>Patient Code</th>

            <th>Patient Name</th>

            <th>Disease</th>

            <th>Amount</th>

            <th>Date</th>

            <th>Action</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.VisitNumber</td>

                <td>@item.PatientCode</td>

                <td>@item.PatientName</td>

                <td>@item.Disease</td>

                <td>₹ @item.AmountPaid</td>

                <td>
                    @item.VisitDate.ToString("dd-MMM-yyyy")
                </td>

                <td>

                    <a asp-action="VisitDetails"
                           asp-route-id="@item.VisitId"
                           class="btn btn-info btn-sm">

                        View

                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>