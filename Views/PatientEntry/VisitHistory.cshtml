@model List<ClinicCare.ViewModels.VisitHistoryViewModel>

@{
    Layout = "_DashboardLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="mb-0">
            Visit History
        </h2>

        <small class="text-muted">
            View all patient visit records
        </small>

    </div>

</div>

<div class="card shadow-sm border-0">

    <div class="card-header bg-white">

        <h5 class="mb-0">

            <i class="bi bi-clock-history me-2"></i>

            All Visits

        </h5>
        

    </div>

    

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Visit No</th>

                        <th>Patient Code</th>

                        <th>Patient Name</th>

                        <th>Disease</th>

                        <th>Amount</th>

                        <th>Date</th>

                        <th width="120">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <span class="badge bg-primary">

                                        @item.VisitNumber

                                    </span>

                                </td>

                                <td>
                                    @item.PatientCode
                                </td>

                                <td>

                                    <a asp-action="PatientProfile"
                                       asp-route-id="@item.PatientId"
                                       class="text-decoration-underline fw-semibold">

                                        @item.PatientName

                                    </a>

                                </td>

                                <td>


                                        @item.Disease


                                </td>

                                <td class="fw-bold text-success">

                                    ₹ @item.AmountPaid

                                </td>

                                <td>

                                    @item.VisitDate.ToString("dd-MMM-yyyy")

                                </td>

                                <td>

                                    <a asp-action="VisitDetails"
                                       asp-route-id="@item.VisitId"
                                       class="btn btn-outline-primary btn-sm">

                                        <i class="bi bi-eye me-1"></i>

                                        View

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center text-muted py-4">

                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>

                                No visit history found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    

</div>