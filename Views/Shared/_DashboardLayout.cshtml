<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>ClinicCare</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>

<body>

    <nav class="navbar navbar-dark bg-primary">
        <div class="container-fluid">

            <span class="navbar-brand">
                ClinicCare
            </span>

            <div>
                Welcome, @User.Identity?.Name

                <a asp-controller="Account"
                       asp-action="Logout"
                       class="btn btn-danger btn-sm ms-3">
                    Logout
                </a>
            </div>

        </div>
    </nav>

    <div class="container-fluid">

        <div class="row">

            <div class="col-md-2 bg-light min-vh-100">

                <ul class="nav flex-column mt-3">

                    <li class="nav-item">
                        <a class="nav-link"
                               asp-controller="Admin"
                               asp-action="Dashboard">
                            Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                               asp-controller="PatientEntry"
                               asp-action="Create">
                            Patient Entry
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                               asp-controller="PatientEntry"
                               asp-action="Today">
                            Today's Entries
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                               asp-controller="PatientEntry"
                               asp-action="VisitHistory">

                            Visit History

                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link">
                            Patients
                        </a>
                    </li>

                    
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-controller="DiseaseCategory"
                                   asp-action="Index">
                                Disease Categories
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-controller="MedicineCategory"
                                   asp-action="Index">
                                Medicine Categories
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-controller="Medicine"
                                   asp-action="Index">
                                Medicines
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-controller="MedicinePurchase"
                                   asp-action="Create">
                                Medicines Purchase
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="MedicinePurchase"
                           asp-action="History">

                        Medicine Purchase History

                    </a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-controller="ExpenseCategory"
                                   asp-action="Index">
                                Expense Categories
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" 
                                    asp-controller="Expense"
                                   asp-action="Index">
                                Expenses
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                                asp-controller="Expense"
                               asp-action="Report">
                                Expense Report
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Compounder"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                                asp-controller="Compounder"
                               asp-action="Appointments">
                                Appointments
                            </a>
                        </li>
                    }

                </ul>

            </div>

            <div class="col-md-10 p-4">

                @RenderBody()

            </div>

        </div>

    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>