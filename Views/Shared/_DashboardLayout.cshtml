<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>ClinicCare</title>
    <link rel="shortcut icon"
          href="~/fevicon.ico" />
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            body {
                background: #eef2f7;
            }

            .sidebar {
                background: #1e293b;
                height: calc(100vh - 65px);
                overflow-y: auto;
                padding-top: 20px;
            }

                .sidebar .nav-link {
                    color: #cbd5e1;
                    padding: 12px 18px;
                    border-radius: 8px;
                    margin: 4px 10px;
                    font-weight: 500;
                }

                    .sidebar .nav-link:hover {
                        background: #334155;
                        color: white;
                    }

                    .sidebar .nav-link.active {
                        background: #2563eb;
                        color: white;
                    }

                .sidebar::-webkit-scrollbar,
                .content-area::-webkit-scrollbar {
                    width: 6px;
                }

                .sidebar::-webkit-scrollbar-thumb,
                .content-area::-webkit-scrollbar-thumb {
                    background: #64748b;
                    border-radius: 10px;
                }

            .content-area {
                padding: 15px;
                height: calc(100vh - 65px);
                overflow-y: auto;
            }

            .topbar {
                height: 65px;
                background: white;
                box-shadow: 0 2px 10px rgba(0,0,0,.05);
            }

            .page-card {
                background: #fefefe;
                border: 1px solid #e5e7eb;
                border-radius: 12px;
                padding: 10px;
                box-shadow: 0 2px 10px rgba(0,0,0,.05);
            }

            .dashboard-card {
                border: none;
                border-radius: 14px;
                transition: .2s;
                box-shadow: 0 4px 12px rgba(0,0,0,.10);
                background: #f8f7fc;
            }

                .dashboard-card .card-body {
                    padding: 18px;
                }
                .dashboard-card:hover {
                    transform: translateY(-3px);
                }

            .dashboard-icon {
                font-size: 24px;
                margin-bottom: 8px;
            }

            .dashboard-number {
                font-size: 24px;
                font-weight: 700;
                margin-top: 5px;
            }

            .dashboard-card h6 {
                color: #65748f;
                font-weight: 600;
                margin-bottom: 0;
            }

            .card-primary {
                border-left: 5px solid #2563eb;
            }

            .card-success {
                border-left: 5px solid #16a34a;
            }

            .card-danger {
                border-left: 5px solid #dc2626;
            }

            .card-warning {
                border-left: 5px solid #f59e0b;
            }

    </style>
</head>

<body>

    <nav class="navbar topbar">
        <div class="container-fluid">

                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="text-decoration-none">

                    <img src="~/images/Nav_Logo.png"
                         alt="ClinicCare"
                         style="height:55px;" />

                </a>
            

            <div>
                <span class="fw-semibold">
                    <i class="bi bi-person-circle me-2"></i>
                    Welcome,@User.Identity?.Name
                </span>

                <a asp-controller="Account"
                       asp-action="Logout"
                       class="btn btn-danger btn-sm ms-3">
                    <i class="bi bi-box-arrow-right me-1"></i>
                    Logout
                </a>
            </div>

        </div>
    </nav>

    <div class="container-fluid">

        <div class="row">

            <div class="col-md-2 sidebar">

                <ul class="nav flex-column mt-3">
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Admin"
                               asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-2"></i>
                                Dashboard
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Compounder"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Compounder"
                               asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-2"></i>
                                Dashboard
                            </a>
                        </li>
                    }
                    
                    <li class="nav-item">
                        <a class="nav-link"
                               asp-controller="PatientEntry"
                               asp-action="Create">
                            <i class="bi bi-person-plus me-2"></i>
                            Patient Entry
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                               asp-controller="PatientEntry"
                               asp-action="Today">
                            <i class="bi bi-journal-medical me-2"></i>
                            Today's Entries
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                               asp-controller="PatientEntry"
                               asp-action="VisitHistory">
                            <i class="bi bi-clock-history me-2"></i>
                            Visit History

                        </a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-controller="DiseaseCategory"
                                   asp-action="Index">
                                <i class="bi bi-heart-pulse me-2"></i>
                                Disease Categories
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-controller="MedicineCategory"
                                   asp-action="Index">
                                <i class="bi bi-tags me-2"></i>
                                Medicine Categories
                            </a>
                        </li>
                    }
                    
                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-controller="Medicine"
                                   asp-action="Index">
                            <i class="bi bi-capsule-pill me-2"></i>
                                Medicines
                            </a>
                        </li>
                    
                    
                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-controller="MedicinePurchase"
                                   asp-action="Create">
                            <i class="bi bi-box-seam me-2"></i>
                                Medicines Purchase
                            </a>
                        </li>
                    
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="MedicinePurchase"
                           asp-action="History">
                            <i class="bi bi-card-checklist me-2"></i>
                        Medicine Purchase History

                    </a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                                   asp-controller="ExpenseCategory"
                                   asp-action="Index">
                                <i class="bi bi-folder2-open me-2"></i>
                                Expense Categories
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" 
                                    asp-controller="Expense"
                                   asp-action="Index">
                                <i class="bi bi-cash-stack me-2"></i>
                                Expenses
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                                asp-controller="Expense"
                               asp-action="Report">
                                <i class="bi bi-graph-up-arrow me-2"></i>
                                Expense Report
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Compounder"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                                asp-controller="Compounder"
                               asp-action="Appointments">
                                <i class="bi bi-calendar-check me-2"></i>
                                Appointments
                            </a>
                        </li>
                    }

                </ul>

            </div>

            <div class="col-md-10 content-area">

                <div class="page-card">

                    @RenderBody()

                </div>

            </div>

        </div>

    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>