<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>ClinicCare Patient Portal</title>

    <link rel="icon"
          href="~/fevicon.ico" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

            body {
                background: #eef2f7;
            }

            .topbar {
                background: white;
                border-bottom: 1px solid #e5e7eb;
                box-shadow: 0 2px 10px rgba(0,0,0,.05);
            }

            .page-card {
                background: white;
                border-radius: 12px;
                padding: 25px;
                box-shadow: 0 2px 10px rgba(0,0,0,.05);
            }

            .navbar-nav .nav-link {
                color: #475569 !important;
                font-weight: 500;
                margin-left: 10px;
                border-radius: 8px;
                padding: 8px 14px !important;
            }

                .navbar-nav .nav-link:hover {
                    background: #f1f5f9;
                }

            .portal-logo {
                height: 45px;
            }

            .welcome-text {
                color: #64748b;
                font-size: 14px;
            }

            .auto-alert {
                position: fixed;
                top: 90px;
                right: 20px;
                z-index: 9999;
                min-width: 300px;
            }

    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg topbar">

        <div class="container-fluid">

            <a asp-controller="Patient"
               asp-action="Dashboard">

                <img src="~/images/Nav_Logo.png"
                     class="portal-logo" />

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarContent">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Patient"
                           asp-action="Dashboard">

                            <i class="bi bi-speedometer2 me-1"></i>

                            Dashboard

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Patient"
                           asp-action="Profile">

                            <i class="bi bi-person-circle me-1"></i>

                            My Profile

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Patient"
                           asp-action="VisitHistory">

                            <i class="bi bi-clock-history me-1"></i>

                            My Visits

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link bg-danger text-light"
                           asp-controller="PatientAccount"
                           asp-action="Logout">

                            <i class="bi bi-box-arrow-right me-1"></i>

                            Logout

                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <div class="container mt-4">

        <div class="page-card">

            @RenderBody()

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>