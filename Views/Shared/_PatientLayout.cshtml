<!DOCTYPE html>

<html>

<head>

    <title>Patient Portal</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">

        <div class="container-fluid">

            <a class="navbar-brand"
               asp-controller="Patient"
               asp-action="Dashboard">

                Patient Portal

            </a>

            <div class="navbar-nav">

                <a class="nav-link"
                   asp-controller="Patient"
                   asp-action="Dashboard">

                    Dashboard

                </a>

                <a class="nav-link"
                   asp-controller="Patient"
                   asp-action="Profile">

                    My Profile

                </a>

                <a class="nav-link"
                   asp-controller="Patient"
                   asp-action="VisitHistory">

                    My Visits

                </a>

                <a class="nav-link"
                   asp-controller="PatientAccount"
                   asp-action="Logout">

                    Logout

                </a>
                

            </div>

        </div>

    </nav>

    <div class="container mt-4">

        @RenderBody()

    </div>

</body>

</html>